# Sarvam AI STT & TTS API Key (Required for live voice STT streaming)
SARVAM_API_KEY=your_sarvam_api_key_here

# Fast Hosted LLM Provider API Keys (Optional - default uses local quantized engine)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM Server URL (Optional if running vLLM or llama.cpp locally)
LOCAL_LLM_URL=http://localhost:8080/v1
LLM_PROVIDER=auto

# Qdrant Vector Store Config (Defaults to in-memory HNSW vector search)
QDRANT_HOST=:memory:
QDRANT_PORT=6333
